# MoneyTalks API - environment configuration
# Copy to .env and adjust. Never commit real secrets.

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# MongoDB - local dev default. Use Atlas connection string for cloud.
MONGODB_URI=mongodb://127.0.0.1:27017/moneytalks

# JWT - use a long random string (>= 32 chars) in every environment.
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789ab
JWT_ACCESS_TTL_SECONDS=900

# Refresh tokens
REFRESH_TOKEN_TTL_DAYS=30

# Logging
LOG_LEVEL=info

# CORS allowlist (comma separated, no wildcards)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (auth endpoints)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=5

# Brute force protection
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
