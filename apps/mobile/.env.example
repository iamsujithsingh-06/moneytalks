# MoneyTalks Mobile - environment configuration
# Copy to .env.production (for APK builds) or .env (for local dev) and adjust.
# Never commit real secrets. Both files are gitignored.

# Backend base URL. Used to build the APK for a real device / emulator.
# SECURITY: must be an HTTPS endpoint for the released Android build. Cleartext
# HTTP is blocked by the network security config (network_security_config.xml)
# and androidScheme:'https', so a plain http:// base URL will NOT work on device.
# Point this at a TLS-terminated endpoint for the API (apps/api, default port
# 3000), e.g. https://api.yourdomain.com/api/v1.
# For web dev this is optional (defaults to http://localhost:3000/api/v1);
# for web prod it defaults to the same-origin /api/v1.
#
# Without this, a production (APK) build falls back to a relative "/api/v1",
# which in the Capacitor WebView resolves to the device itself and cannot
# reach your backend.
VITE_API_BASE_URL=https://api.example.com/api/v1
